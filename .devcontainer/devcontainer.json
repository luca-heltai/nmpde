{
  "name": "NMPDE — deal.II 9.7.1",
  "image": "dealii/dealii:v9.7.1-noble",
  "workspaceFolder": "/workspaces/nmpde",
  "remoteUser": "root",
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "postCreateCommand": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel 2"
}
