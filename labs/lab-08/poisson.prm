subsection Poisson
  set Initial refinement = 2
  set Number of cycles = 4
  set Refinement = mean-square
  set Exact solution = x + 2*y + sin(pi*x)*sin(pi*y)
  set Right hand side = 2*pi^2*sin(pi*x)*sin(pi*y)
end

subsection Convergence table
  set Extra columns = cells, dofs
  set List of error norms to compute = L2_norm, H1_seminorm
  set Error precision = 6
  set Rate key =
  set Rate mode = none
end
